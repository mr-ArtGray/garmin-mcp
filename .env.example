# Copy to .env and adjust. None of these are required for local stdio use.

# Where the Garmin session tokens live. Written once by `garmin-mcp-login`.
# In a container, mount this path as a secret.
# GARMINTOKENS=~/.garminconnect

# "stdio" (default, local) or "streamable-http" (remote).
# GARMIN_MCP_TRANSPORT=stdio

# HTTP transport bind address. Only used when transport is streamable-http.
# GARMIN_MCP_HOST=127.0.0.1
# GARMIN_MCP_PORT=8000

# REQUIRED when transport is streamable-http. Clients must send:
#   Authorization: Bearer <this value>
# The server refuses to start over HTTP without it.
# GARMIN_MCP_AUTH_TOKEN=

# DEBUG | INFO | WARNING | ERROR | CRITICAL
# GARMIN_MCP_LOG_LEVEL=INFO
